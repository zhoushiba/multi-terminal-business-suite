.page {
  min-height: 100vh;
  background: var(--suite-bg);
}

.profile {
  display: flex;
  align-items: center;
  padding: 48rpx 36rpx 60rpx;
  background: linear-gradient(135deg, #1f2740 0%, #2f4478 60%, #3b5bd0 100%);
  color: #fff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4f8bff, #7b61ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-btn {
  font-size: 26rpx;
  color: #1f2740;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
}

.container {
  padding: 24rpx;
  margin-top: -34rpx;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 34rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2740;
}

.stat-label {
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f7;
}

.signup {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.signup:last-child {
  border-bottom: none;
}

.signup-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2740;
  margin-right: 16rpx;
}

.signup-meta {
  margin-top: 10rpx;
}

.signup-code {
  margin-top: 6rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.menu {
  padding: 0 26rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
  font-size: 29rpx;
  color: #1f2740;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #c3c8d4;
  font-size: 32rpx;
}

.danger {
  color: #f04438;
}

.error-text {
  margin-top: 12rpx;
}

.footer {
  text-align: center;
  padding: 24rpx 0 40rpx;
}
