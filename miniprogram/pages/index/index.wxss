.page {
  min-height: 100vh;
  background: var(--suite-bg);
}

.hero {
  background: linear-gradient(135deg, #1f2740 0%, #2f4478 60%, #3b5bd0 100%);
  padding: 36rpx 32rpx 48rpx;
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-city {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.search {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx 10rpx 10rpx 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #1f2740;
}

.search-ph {
  color: #b3b8c6;
}

.search-btn {
  background: linear-gradient(135deg, #4f8bff, #2f6bff);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
}

.container {
  padding: 24rpx;
}

.quick-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 18rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: rgba(47, 107, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #47506b;
  text-align: center;
}

.activity {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.activity:last-child {
  border-bottom: none;
}

.activity-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2740;
  margin-right: 16rpx;
}

.activity-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6b7385;
  line-height: 38rpx;
}

.activity-meta {
  margin-top: 12rpx;
}

.content-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.content-item:last-child {
  border-bottom: none;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2740;
  line-height: 42rpx;
}

.content-summary {
  margin-top: 8rpx;
  line-height: 36rpx;
}

.content-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.content-meta-text {
  margin-left: 16rpx;
}

.error-box {
  text-align: center;
  padding: 30rpx 0;
}

.retry {
  display: inline-block;
  margin-top: 16rpx;
  color: var(--suite-primary);
  font-size: 26rpx;
}

.footer {
  text-align: center;
  padding: 20rpx 0 40rpx;
}
