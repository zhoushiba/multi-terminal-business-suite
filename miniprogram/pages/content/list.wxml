<view class="page">
  <view class="toolbar">
    <view class="search">
      <input
        class="search-input"
        placeholder="搜索标题、摘要"
        placeholder-class="search-ph"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <scroll-view class="tabs" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        class="tab {{categoryId === 0 ? 'tab-active' : ''}}"
        data-id="0"
        bindtap="onCategoryTap"
      >全部</view>
      <view
        class="tab {{categoryId === item.id ? 'tab-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </scroll-view>
  </view>

  <view class="container">
    <view class="list-total muted" wx:if="{{total}}">共 {{total}} 条内容</view>

    <block wx:if="{{list.length}}">
      <view
        class="card content-item"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onContentTap"
      >
        <view class="content-head">
          <text class="tag tag-top" wx:if="{{item.topFlag}}">置顶</text>
          <text class="tag">{{item.typeText}}</text>
        </view>
        <view class="content-title ellipsis-2">{{item.title}}</view>
        <view class="content-summary muted ellipsis-2">{{item.summary}}</view>
        <view class="content-meta muted">
          {{item.author}} · {{item.timeText}} · {{item.viewText}}
        </view>
      </view>
    </block>

    <view wx:if="{{!list.length && !loading}}" class="empty">
      没有找到相关内容，换个关键词试试
    </view>

    <view wx:if="{{loading}}" class="loading-text">正在加载…</view>
    <view wx:if="{{loadingMore}}" class="loading-text">加载更多…</view>
    <view wx:if="{{finished && list.length}}" class="loading-text">已经到底啦</view>

    <view wx:if="{{errorText}}" class="error-box">
      <view class="muted">{{errorText}}</view>
      <view class="retry" bindtap="onRetry">重新加载</view>
    </view>
  </view>
</view>
