# =====================================================================
# 多端业务中台套件 · 环境变量示例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，绝不会提交
# 说明：本地冒烟用 local profile（H2），无需任何外部服务即可跑通
# =====================================================================

# ---------- 后端服务 ----------
# 监听端口（application.yml: server.port=${SERVER_PORT:8080}）
SERVER_PORT=8080
# 激活的 profile：local（H2 文件库 + 全 mock） / prod（MySQL + 真实第三方）
SPRING_PROFILES_ACTIVE=local

# ---------- JWT ----------
# 生产必填，长度 >= 32 字节；可用 `openssl rand -base64 48` 生成
APP_JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes

# ---------- MySQL（仅 prod profile / docker-compose 使用） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=business_suite
DB_USERNAME=suite
DB_PASSWORD=change-me
# docker-compose 里 MySQL 容器 root 密码
MYSQL_ROOT_PASSWORD=root-change-me

# ---------- 缓存 ----------
# memory（默认，无 Redis 也可跑） / redis
APP_CACHE_TYPE=memory
APP_REDIS_URI=redis://127.0.0.1:6379

# ---------- AI 能力 ----------
# provider=mock 时返回可预期的本地模拟结果，离线可跑；
# 配 OpenAI 兼容网关时改成 openai，并填写 base-url / api-key / model
APP_AI_PROVIDER=mock
APP_AI_BASE_URL=https://api.openai.com/v1
APP_AI_API_KEY=
APP_AI_MODEL=gpt-4o-mini

# ---------- 对象存储 ----------
# local：写本地目录；oss：走对象存储（需要 endpoint/bucket/ak/sk）
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_ROOT=./data/uploads
APP_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads
APP_STORAGE_ENDPOINT=
APP_STORAGE_BUCKET=
APP_STORAGE_ACCESS_KEY_ID=
APP_STORAGE_ACCESS_KEY_SECRET=

# ---------- 微信小程序 ----------
# mock=true 时 /api/wx/login 用 code 换演示账号，无需真实 AppID；
# 生产配好 appId/appSecret 后必须改为 false
APP_WECHAT_APP_ID=
APP_WECHAT_APP_SECRET=
APP_WECHAT_MOCK=true

# ---------- CORS ----------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# ---------- 前端（Vite） ----------
# 开发环境走 vite proxy，这里保持 /api 即可；若前后端分离部署可填完整域名
VITE_API_BASE_URL=/api
VITE_APP_TITLE=业务中台管理后台

# ---------- docker-compose ----------
# 前端 Nginx 对外端口
WEB_PORT=8081
